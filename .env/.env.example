# datev-mcp settings. Copy this file to .env/.env.local, fill in your own values,
# and start the server with: node --env-file=.env/.env.local dist/index.js
# .env/.env.local is ignored by git. Never commit real values.

# Your app in the DATEV developer portal (developer.datev.de, Dashboard, your app)
DATEV_CLIENT_ID=your-client-id-from-the-portal
DATEV_CLIENT_SECRET=your-client-secret-from-the-portal

# sandbox (default, test data only) or production (needs DATEV's technical review)
DATEV_ENV=sandbox

# Optional. Space separated OAuth scopes. Leave empty to request every scope the
# operation index knows, e.g. "openid accounting:clients:read accounting:documents"
DATEV_SCOPES=

# Optional. Folder for the saved login session. Default ~/.config/datev-mcp
DATEV_MCP_HOME=

# Optional. Set to 1 so `login` only prints the sign-in link instead of opening a browser (SSH, other browser)
DATEV_MCP_NO_BROWSER=

# Only for the live tests (npm run test:live, npm run sweep)
# A sandbox client id from your DATEV sandbox test data, e.g. 455148-1
DATEV_LIVE_CLIENT=455148-1
# Optional launcher that injects the credentials from a password manager
DATEV_MCP_LAUNCHER=
# Sweep pacing: calls per day and milliseconds between calls
DATEV_SWEEP_MAX=150
DATEV_SWEEP_GAP_MS=3000
