# datev-mcp settings. Copy this file to .env/.env.local, fill in your own values,
# and start the server with: node --env-file=.env/.env.local dist/index.js
# .env/.env.local is ignored by git. Never commit real values.

# Required. The app's client id from the DATEV developer portal (developer.datev.de).
DATEV_CLIENT_ID=your-client-id-from-the-portal

# Only for a Confidential app. Leave this line out for a Public client, which production requires.
# DATEV_CLIENT_SECRET=your-client-secret-from-the-portal

# sandbox (default, test data only) or production (needs DATEV's technical review)
DATEV_ENV=sandbox

# Data services to connect, comma separated, the same as `login --services`.
# Only their scopes are requested. `login --services` wins over this.
# DATEV_MCP_SERVICES=accounting-dataexchange,accounting-documents

# Experts only. Exact space separated scopes, used only when no data service is chosen
# (no DATEV_MCP_SERVICES and no `login --services`). With neither, login refuses.
# DATEV_SCOPES=

# Optional. Absolute path for the saved login session.
# Default $XDG_CONFIG_HOME/datev-mcp, else ~/.config/datev-mcp. An empty value counts as unset.
DATEV_MCP_HOME=

# Optional. Absolute path for the technical HTTP log. Default the logs folder inside the session folder.
# DATEV_MCP_LOG_DIR=

# Optional. 64 hex characters (or base64 of 32 bytes) when no OS credential store is available.
# DATEV_MCP_SESSION_KEY=

# Sandbox only. token (default) lets the preview's confirm code approve a write; human asks you in the client.
# Production always asks you, whatever this says.
# DATEV_MCP_CONFIRM=token

# Optional. The X-API-Key for SmartTransfer. It stays in the server.
# DATEV_SMARTTRANSFER_API_KEY=

# Optional. de for German messages. Anything else, or nothing, keeps English.
# DATEV_MCP_LANG=

# Optional. Set to 1 so `login` only prints the sign-in link instead of opening a browser (SSH, other browser)
DATEV_MCP_NO_BROWSER=

# Only for the live tests (npm run test:live, npm run sweep)
# A sandbox client id from your DATEV sandbox test data, e.g. 455148-1
DATEV_LIVE_CLIENT=455148-1
# Optional launcher that injects the credentials from a password manager
DATEV_MCP_LAUNCHER=
# Sweep pacing: calls per day and milliseconds between calls
DATEV_SWEEP_MAX=150
DATEV_SWEEP_GAP_MS=3000
# Set to 1 to call every operation again, not only the unfinished ones
# DATEV_SWEEP_ALL=
