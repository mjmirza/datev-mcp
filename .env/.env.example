# DATEV developer portal app (developer.datev.de > Dashboard > your app)
DATEV_CLIENT_ID=your-client-id-from-the-portal
DATEV_CLIENT_SECRET=your-client-secret-from-the-portal

# sandbox or production
DATEV_ENV=sandbox

# Must match a Redirect-URL registered on the app
DATEV_REDIRECT_URI=http://localhost
